{
  "uid": "tasky-api-performance",
  "title": "Tasky API Performance",
  "tags": ["tasky", "backend", "api", "performance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__PROM_UID__"
        },
        "query": "label_values(http_server_request_duration_seconds_count, service_name)",
        "current": {
          "text": "__SERVICE_NAME__",
          "value": "__SERVICE_NAME__"
        },
        "refresh": 2
      },
      {
        "name": "route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__PROM_UID__"
        },
        "query": "label_values(http_server_request_duration_seconds_count{service_name=\"$service\"}, http_route)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": ".*"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request Rate (RPS)",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])), 1e-9)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) by (le))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "P99 Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) by (le))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency by Route (P95)",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) by (le, http_route))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error Rate by Route",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval])) by (http_route) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) by (http_route), 1e-9)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Throughput by Route (RPS)",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) by (http_route)"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Slowest Routes (avg latency)",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "topk(10, (sum(rate(http_server_request_duration_seconds_sum{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) by (http_route)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) by (http_route), 1e-9))"
        }
      ]
    }
  ]
}
