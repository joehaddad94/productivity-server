# Copy to .env and fill in values. Do not commit .env.

# Supabase PostgreSQL connection string
# 1. Supabase Dashboard → Project → Settings → Database
# 2. Under "Connection string" choose "URI" and copy
# 3. Replace [YOUR-PASSWORD] with your database password
#    (or use "Transaction" pooler for serverless: port 6543)
# Example (direct):
#   DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true"
# Example (session pooler, port 6543):
#   DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
