# Copy to .env or .env.local. Do not commit.

# Supabase + Prisma (from Dashboard → Connect → ORMs → Prisma):
# - DATABASE_URL = connection pooling (app runtime) — port 6543, pgbouncer=true
# - DIRECT_URL = direct connection (migrations) — port 5432

# Replace [YOUR-PASSWORD] with your database password.

# Pooler (app / Prisma Client)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct (migrations only)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Auth (JWT)
# Generate a strong secret
JWT_SECRET=your-super-secret-key-at-least-32-chars
JWT_EXPIRES_IN=14d

# Brevo transactional email (https://app.brevo.com)
# 1. Sign up at brevo.com
# 2. API key: Settings → SMTP & API → API Keys → Create key
# 3. Verify sender: Settings → Senders & IPs → Senders → Add & verify your email
BREVO_API_KEY=your-brevo-api-key
SMTP_FROM_NAME=Tasky
SMTP_FROM_EMAIL=your-verified-sender@email.com

# Base URL for magic links — set to your Railway domain in production
APP_URL=http://localhost:8000

# After opening the magic link, redirect the user here (e.g. frontend dashboard).
# If set, GET /auth/verify will redirect to this URL instead of returning JSON.
# AUTH_VERIFY_REDIRECT_URL=http://localhost:5173/dashboard

# OpenTelemetry (Grafana Cloud). From Grafana Cloud: Connections → OpenTelemetry → JavaScript.
# Use the HTTP endpoint (e.g. https://otlp-gateway-xxxx.grafana.net/otlp), NOT gRPC, NOT Prometheus remote write.
#
# Step 2 — Auth header: Grafana requires Base64(instanceID:APIkey). Copy the FULL value from
# Grafana's "Append the generated configuration" (OTEL_EXPORTER_OTLP_HEADERS). It is NOT just the API key.
# Example format: Authorization=Basic%20BASE64_RESULT  (paste as-is from Grafana).
#
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-central-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20YOUR_BASE64_CREDENTIALS
# OTEL_SERVICE_NAME=tasky-server
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
