// Prisma schema for Tasky – Supabase (PostgreSQL)
// https://pris.ly/d/prisma-schema


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth & users ---
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String?
  avatarUrl  String?   @map("avatar_url")
  timezone   String?
  updatedAt  DateTime @updatedAt @map("updated_at")

  sessions              Session[]
  workspaceMembers      WorkspaceMember[]
  assignedNotes         Note[]                @relation("NoteAssignee")
  dailyStats            DailyStat[]
  notifications         Notification[]
  notificationSettings  NotificationSettings?
  pushSubscriptions     PushSubscription[]
  calendarConnections   CalendarConnection[]

  @@map("users")
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  name      String?
  token     String   @unique
  expiresAt DateTime @map("expires_at")

  @@map("verification_tokens")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// --- Workspaces ---
model Workspace {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  isPersonal Boolean  @default(false) @map("is_personal")
  createdAt  DateTime @default(now()) @map("created_at")

  members            WorkspaceMember[]
  projects           Project[]
  tasks              Task[]
  notes              Note[]
  dailyStats         DailyStat[]
  notifications      Notification[]
  workspaceTaskStatuses WorkspaceTaskStatus[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        String   @default("member")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

/// Per-workflow columns for tasks. `key` is set for the three built-in rows (pending / in_progress / completed); custom statuses use key = null.
model WorkspaceTaskStatus {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  key         String?   @map("key")
  name        String
  sortOrder   Int       @map("sort_order")
  isTerminal  Boolean   @default(false) @map("is_terminal")
  color       String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, sortOrder])
  @@map("workspace_task_statuses")
}

// --- Projects & tasks ---
model Project {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  status      String   @default("active")
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notes     Note[]
  tasks     Task[]

  @@index([workspaceId])
  @@map("projects")
}

model Task {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  title          String
  description    String?
  dueDate        DateTime? @map("due_date") @db.Date
  dueTime        String?   @map("due_time")
  priority       String?
  status         String    @default("pending")
  completedAt    DateTime? @map("completed_at")
  parentTaskId   String?   @map("parent_task_id")
  focusMinutes        Int       @default(0) @map("focus_minutes")
  sortOrder           Int       @default(0) @map("sort_order")
  recurrenceRule      String?   @map("recurrence_rule")
  recurrenceParentId  String?   @map("recurrence_parent_id")
  projectId           String?   @map("project_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  deletedAt           DateTime? @map("deleted_at")

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentTask       Task?     @relation("Subtask", fields: [parentTaskId], references: [id])
  subtasks         Task[]    @relation("Subtask")
  recurrenceParent Task?     @relation("RecurringInstance", fields: [recurrenceParentId], references: [id])
  recurrenceChildren Task[]  @relation("RecurringInstance")
  notes            Note[]
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([parentTaskId])
  @@index([workspaceId, projectId])
  @@map("tasks")
}

model Note {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  projectId    String?   @map("project_id")
  assigneeId   String?   @map("assignee_id")
  taskId       String?   @map("task_id")
  title        String
  content      String?   @map("content")
  tags         String[]  @default([])
  status       String?
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("NoteAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, projectId])
  @@map("notes")
}

// --- Notifications ---
model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  taskId      String?  @map("task_id")
  type        String   // due_today | overdue | daily_agenda
  title       String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId])
  @@index([userId, read])
  @@map("notifications")
}

model NotificationSettings {
  id               String  @id @default(uuid())
  userId           String  @unique @map("user_id")
  inApp            Boolean @default(true)  @map("in_app")
  email            Boolean @default(false)
  push             Boolean @default(false)
  dailyAgendaTime  String  @default("08:00") @map("daily_agenda_time")
  quietHoursStart  String? @map("quiet_hours_start")
  quietHoursEnd    String? @map("quiet_hours_end")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// --- Analytics ---
model DailyStat {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  userId         String   @map("user_id")
  date           DateTime @db.Date
  tasksCompleted Int      @default(0) @map("tasks_completed")
  focusMinutes   Int      @default(0) @map("focus_minutes")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, date])
  @@index([userId])
  @@map("daily_stats")
}

// --- Calendar integrations ---
model CalendarConnection {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  provider     String    // "google" | "microsoft"
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("calendar_connections")
}
